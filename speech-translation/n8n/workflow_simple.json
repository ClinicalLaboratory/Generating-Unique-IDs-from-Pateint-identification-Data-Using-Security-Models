{
  "name": "Simple Speech Translation",
  "nodes": [
    {
      "parameters": {
        "path": "speech-translate",
        "responseMode": "responseNode",
        "options": {
          "binaryData": true
        }
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract target language from request\nconst targetLang = $input.first().json.body?.targetLang || \n                  $input.first().json.query?.targetLang || \n                  $input.first().json.targetLang || 'en';\n\n// Get the audio binary data\nconst audioBinary = $input.first().binary?.audio;\n\nif (!audioBinary) {\n  throw new Error('No audio data found in request');\n}\n\n// Return the data for the next node\nreturn {\n  json: { targetLang },\n  binary: { audio: audioBinary }\n};"
      },
      "id": "code",
      "name": "Extract Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://whisper-service:8001/transcribe-translate",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.targetLang }}"
            }
          ]
        },
        "sendBinaryData": true,
        "binaryPropertyName": "audio",
        "options": {
          "timeout": 300000,
          "allowUnauthorizedCerts": true
        }
      },
      "id": "http",
      "name": "Whisper Transcribe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [600, 300]
    },
    {
      "parameters": {
        "responseBody": "={{ $json }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [800, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Extract Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Data": {
      "main": [
        [
          {
            "node": "Whisper Transcribe",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Whisper Transcribe": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}